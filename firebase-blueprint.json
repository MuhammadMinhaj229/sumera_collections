{
  "entities": {
    "cart": {
      "title": "Cart",
      "description": "User cart",
      "type": "object",
      "properties": {
        "items": { "type": "array" }
      }
    },
    "wishlist": {
      "title": "Wishlist",
      "description": "User wishlist",
      "type": "object",
      "properties": {
        "items": { "type": "array" }
      }
    },
    "points": {
      "title": "Points",
      "description": "User points",
      "type": "object",
      "properties": {
        "balance": { "type": "number" },
        "history": { "type": "array" },
        "claimedRewards": { "type": "array" }
      }
    },
    "profile": {
      "title": "Profile",
      "description": "User profile",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "pincode": { "type": "string" }
      }
    },
    "order": {
      "title": "Order",
      "description": "User order",
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "date": { "type": "string" }
      }
    },
    "product": {
      "title": "Product",
      "description": "E-commerce product definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "price": { "type": "number" },
        "mrp": { "type": "number" },
        "category": { "type": "string" },
        "fabric": { "type": "string" },
        "sizes": { "type": "array" },
        "description": { "type": "string" },
        "type": { "type": "string" },
        "badges": { "type": "array" },
        "images": { "type": "array" },
        "colors": { "type": "array" },
        "hasBottom": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "specs": { "type": "array" },
        "sizeChart": { "type": "object" },
        "reviews": { "type": "array" }
      }
    },
    "global_order": {
      "title": "Global Order",
      "description": "Global placed order details for administration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "shippingDetails": { "type": "object" }
      }
    },
    "return_request": {
      "title": "Return Request",
      "description": "Customer return or exchange request details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "email": { "type": "string" },
        "type": { "type": "string" },
        "reason": { "type": "string" },
        "items": { "type": "array" },
        "exchangeDetails": { "type": "object" },
        "refundMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "resolvedAt": { "type": "string" },
        "image": { "type": "string" },
        "adminNotes": { "type": "string" },
        "adminPin": { "type": "string" }
      }
    },
    "settings": {
      "title": "Settings",
      "description": "Global settings for customizing the store",
      "type": "object",
      "properties": {
        "heroImage": { "type": "string" },
        "heroBadge": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "adminPin": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}/data/cart": { "schema": "cart", "description": "User cart" },
    "/users/{userId}/data/wishlist": { "schema": "wishlist", "description": "User wishlist" },
    "/users/{userId}/data/points": { "schema": "points", "description": "User points" },
    "/users/{userId}/data/profile": { "schema": "profile", "description": "User profile" },
    "/users/{userId}/orders/{orderId}": { "schema": "order", "description": "User orders" },
    "/products/{productId}": { "schema": "product", "description": "Global catalog products" },
    "/global_orders/{orderId}": { "schema": "global_order", "description": "Global store orders list for Admin" },
    "/return_requests/{requestId}": { "schema": "return_request", "description": "Customer return/exchange requests" },
    "/settings/{settingId}": { "schema": "settings", "description": "Global customizer settings" }
  }
}
